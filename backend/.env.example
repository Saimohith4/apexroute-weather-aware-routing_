# Copy this file to .env for local development; replace placeholder values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
OPENROUTESERVICE_API_KEY=replace-with-your-openrouteservice-key
# Optional for local PostgreSQL; omit to use local SQLite while DEBUG=True.
# DATABASE_URL=postgresql://user:password@localhost:5432/apexroute
